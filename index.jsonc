{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_multi_maintain",

  // 1-2 sentence summary about this repo.
  "summary": "gg do maintain: SDK, DNA and dependency upgrades in all ocean repos in parallel, dependency order, every changed repo committed and published on its own; --nightly for a nightly build.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "maintenance runs over the ocean: fresh clone per repo, DAG scheduling, --jobs, --org/--repo filters, --dry-run",
    "tasks: --upgrade-sdk, --upgrade-deps [--major], --upgrade-dna (layers, then gg dna upgrade); --nightly = --upgrade-deps --major",
    "summary per outcome; failed repo blocks its dependents; report.txt in the run folder on problems",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_one": "DoUpgradeDeps, DoCommit, DoPublish per repo",
      "gg_multi_core": "WorkspaceUtils: ocean path",
      "gg_publish": "IsPublished: skip never published packages",
      "gg_local_package_dependencies": "dependency order of the ocean repos",
      "gg_lang": "publish targets of a repo",
      "gg_process": "processes, FlutterInShellProcessWrapper",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_multi": "registers DoMaintain as gg do maintain",
    },
  },
}
